+/// TEMPORARY (Batch 4c §2 attribution, removed after): features switched off
+/// by `CARTWAVE_B4C_OFF=clip,held,mainlr,voices,frozenvar`, parsed once.
+pub fn exp_off(name: &str) -> bool {
+    static OFF: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    OFF.get_or_init(|| var("CARTWAVE_B4C_OFF").map(|v| v.split(',').map(|s| s.trim().to_string()).collect()).unwrap_or_default())
+        .iter()
+        .any(|s| s == name)
+}
