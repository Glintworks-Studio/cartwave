-    if let Some(Some(clip_path)) = cx.cache.clip_path.get(current) {
-        canvas.clip_path(clip_path, ClipOp::Intersect, true);
+    if let Some(Some(shapes)) = cx.cache.clip_shapes.get(current) {
+        apply_clip_shapes(canvas, shapes);
     }
 
